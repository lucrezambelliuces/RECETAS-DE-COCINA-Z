* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background-color: #f4f4f4;
    color: #333;
}

header {
    background-color: #ff914d;
    color: white;
    padding: 20px;
    text-align: center;
}

nav ul {
    list-style: none;
    margin-top: 15px;
}

nav ul li {
    display: inline;
    margin: 0 15px;
}

nav ul li a {
    color: white;
    text-decoration: none;
    font-weight: bold;
}

section {
    padding: 40px;
}

h2 {
    margin-bottom: 20px;
    color: #ff914d;
}

.receta {
    background-color: white;
    padding: 20px;
    border-radius: 10px;
    margin-bottom: 30px;
}

.receta img {
    width: 100%;
    max-width: 400px;
    border-radius: 10px;
    margin-bottom: 15px;
}

h3 {
    margin-bottom: 10px;
}

h4 {
    margin-top: 15px;
    margin-bottom: 10px;
}

ul {
    margin-left: 20px;
}

p {
    margin-top: 10px;
    line-height: 1.6;
}

footer {
    background-color: #333;
    color: white;
    text-align: center;
    padding: 20px;
}